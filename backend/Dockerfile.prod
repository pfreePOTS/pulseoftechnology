# Production backend image for Railway / staging — no bind mounts or --reload.

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./backend/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

EXPOSE 8000

# Railway sets PORT; default 8000 for local/smoke builds.
CMD ["sh", "-c", "cd /app/backend && alembic upgrade head && exec python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --timeout-graceful-shutdown 30"]
