DATABASE_URL=postgresql://pulse_user:pulse_password@localhost:5532/pulse_db
ENVIRONMENT=development

# Comma-separated origins for browser CORS (must list frontend URL when using credentials; include 127.0.0.1 if you use it)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# HS256 secret for admin JWT cookies / Bearer tokens
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret

# AI pipeline — required for ingestion scoring and topic summarisation
ANTHROPIC_API_KEY=your-api-key-here

# Admin panel password (dev / bootstrap superuser when admin_users is empty)
ADMIN_PASSWORD=your_secure_password

# Login email for that bootstrap account (short name pulseoneadmin works)
FIRST_ADMIN_EMAIL=pulseoneadmin@pulseone.local

# Production: bcrypt hash of admin password (see root .env.example)
# ADMIN_PASSWORD_HASH=

# SendGrid email delivery (optional for ingestion testing)
SENDGRID_API_KEY=SG.your-key-here
SENDGRID_FROM_EMAIL=radar@pulseone.com
SENDGRID_FROM_NAME=PulseOne Radar
SENDGRID_NEWSLETTER_TEMPLATE_ID=

# Public marketing site URL (Next.js radar) for newsletter “dig deeper” links; no trailing slash
PUBLIC_SITE_URL=http://localhost:3100

# Public API URL for newsletter survey and read-online links; no trailing slash
API_BASE_URL=http://localhost:8100

# Optional full URL to logo image for built-in newsletter HTML.
# Must be HTTPS and publicly reachable — email clients cannot load http://localhost assets.
# NEWSLETTER_LOGO_URL=

# HubSpot CRM sync (optional)
HUBSPOT_API_KEY=your-hubspot-pat-here

# Pipeline (optional — overridden by Admin → Settings in DB)
TREND_WINDOW_DAYS=7
TREND_PRIOR_WINDOW_DAYS=7
ARTICLE_RETENTION_DAYS=30
ARTICLE_ARCHIVE_ENABLED=true
NEWSLETTER_ARTICLE_LOOKBACK_DAYS=7
NEWSLETTER_SEND_HOUR_UTC=7
NEWSLETTER_SEND_MINUTE_UTC=0
NEWSLETTER_ENABLED=true
# Pause between subscriber sends (SendGrid rate limiting); 0 disables
NEWSLETTER_SUBSCRIBER_DELAY_SECONDS=0.1
