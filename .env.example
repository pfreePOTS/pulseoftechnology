# Copy this file to .env before running `docker compose up`
# These defaults work for local development out of the box.

# Must match the user created by the Postgres container (docker-compose default).
# Do not use POSTGRES_USER=pulse — that role is not created and you will see
# FATAL: role "pulse" does not exist.
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=pulse_password
POSTGRES_DB=pulse_db

DEEPSEEK_API_KEY=your-api-key-here
# Optional (defaults suit DeepSeek)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# Fast-tier model for user-facing page synthesis (/recommended-path, /everyone)
# RECOMMENDED_PATH_LLM_MODEL=deepseek-v4-flash

# Optional Claude (Anthropic) — first backup if DeepSeek errors, or only LLM if DEEPSEEK_API_KEY is unset
# ANTHROPIC_API_KEY=

# Optional — OpenAI. Chat is the last-resort backup model when DeepSeek and Anthropic fail.
# Also used for Recommended Path / process-card images when enabled.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# RECOMMENDED_PATH_SYNTHESIS_IMAGES_ENABLED=true

# Admin JWT signing (use a long random string in production)
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret

# Separate signing key for subscriber preference/unsubscribe magic links
SUBSCRIBER_TOKEN_SECRET=change-me-to-a-different-long-random-secret

# Bootstrap superuser when admin_users is empty (docker / first deploy). Password: ADMIN_PASSWORD below.
# You may sign in as "pulseoneadmin" — it expands to this email.
FIRST_ADMIN_EMAIL=pulseoneadmin@pulseone.local

# Optional — bcrypt hash of admin password for production (takes precedence over ADMIN_PASSWORD)
# Generate e.g. python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=

# Browser origins allowed for CORS (must include your Next.js dev URL; use localhost OR 127.0.0.1 consistently)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# Root log level for application modules (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
# Hash email= / contact_email= in ops logs (default: on for staging/production)
# LOG_REDACT_EMAILS=true
# Prefer X-Forwarded-For for client_ip in ops logs (default: on for staging/production)
# TRUST_PROXY_HEADERS=true
# ENVIRONMENT=development

# SendGrid email delivery
SENDGRID_API_KEY=SG.your-key-here
SENDGRID_FROM_EMAIL=radar@pulseone.com
SENDGRID_FROM_NAME=PulseOne Radar
# Leave empty to use the built-in HTML newsletter body; otherwise set a SendGrid dynamic template GUID (d-...).
SENDGRID_NEWSLETTER_TEMPLATE_ID=
# Inbound contact form notifications (POST /api/contact)
CONTACT_FORM_TO_EMAIL=marketing@pulseone.com

# HubSpot CRM sync (private app access token)
HUBSPOT_API_KEY=your-hubspot-pat-here
# Optional — nightly full-database push to Contacts + list memberships (same as Admin → HubSpot → Reconcile subscribers)
HUBSPOT_BATCH_SYNC_ENABLED=true
HUBSPOT_BATCH_SYNC_HOUR_UTC=4
HUBSPOT_BATCH_SYNC_MINUTE_UTC=0
# Optional — HubSpot list ILS ID (MANUAL or SNAPSHOT list). Active subscribers added after upsert; inactive removed.
# HUBSPOT_NEWSLETTER_LIST_ID=

# Frontend — browser must reach the API on the host (default matches Compose port map)
NEXT_PUBLIC_API_URL=http://localhost:8100
# Backend-generated newsletter links (surveys/read-online) must also use the host API URL.
API_BASE_URL=http://localhost:8100
# Public site URL used in newsletter links and preference pages.
PUBLIC_SITE_URL=http://localhost:3100
# Canonical origin for SEO metadata: canonical URLs, sitemap.xml, robots.txt, Open Graph, JSON-LD.
# Must be the origin this site is actually served from. Leave unset in production until the app
# takes over pulseone.com, so canonicals never point at a domain serving different content.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Next.js server-side fetches (RSC). In Docker Compose this defaults to http://backend:8000; only set if you override the frontend service.
# SERVER_API_URL=http://backend:8000

# Optional — Pinecone vector search for signal intelligence (omit for local dev)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
# PINECONE_INDEX_NAME=pulseone-articles

# Pipeline (optional — Admin → Settings can override in DB)
# TREND_WINDOW_DAYS=7
# TREND_PRIOR_WINDOW_DAYS=7
# ARTICLE_RETENTION_DAYS=30
# ARTICLE_ARCHIVE_ENABLED=true
# Max raw+retry articles the AI pipeline evaluates per hourly ingest + manual "Process" (default 200; max 2000)
# ARTICLE_PIPELINE_MAX_PER_PASS=200
# NEWSLETTER_ARTICLE_LOOKBACK_DAYS=7
# NEWSLETTER_SEND_HOUR_UTC=7
# NEWSLETTER_SEND_MINUTE_UTC=0
# NEWSLETTER_ENABLED=true
# NEWSLETTER_SUBSCRIBER_DELAY_SECONDS=0.1
