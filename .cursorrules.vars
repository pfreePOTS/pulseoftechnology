ACTIVE_BUGS_DOC=docs/testing/active-bugs.md
ARCHITECTURE_OR_PLAN_DOC=docs/ai-agents-and-flow.md
BACKEND_ENTRY=`backend/main.py` (FastAPI / Uvicorn)
BACKEND_PATH=`backend/`
BUG_ID_SCHEME=PULSE-NNN
BUG_TEMPLATE_DOC=docs/testing/bug-template.md
CACHE_DIRS=`.next`, `__pycache__`, `.pytest_cache`, `.ruff_cache`, `coverage`
DEPENDENCY_UPDATE_FILES=`backend/requirements.txt`, `backend/requirements-dev.txt`, `frontend/package.json` / lockfile; rebuild Compose images after Python dep changes
DEPLOY_CLI_TOOLS=`railway` CLI, `gh`
DEPLOY_HOST=Railway (staging tracks `staging` branch; see `railway/README.md`)
DEV_LOGS_COMMAND=`docker compose logs -f backend frontend`
DEV_START_COMMAND=`docker compose up --build`
DEV_STOP_COMMAND=`docker compose down`
DOCKER_OR_CI_TEST_COMMAND=GitHub Actions `.github/workflows/ci.yml` (backend-lint, backend-test, frontend-lint-test, e2e)
ENV_TEMPLATE_PATH=`.env.example` (and `backend/.env.example`)
EXPLICIT_NON_GOALS=Do not edit sibling repos; prefer Docker Compose over ad-hoc host Python/Node for normal dev
FRONTEND_ENTRY=`frontend/src/app/` (Next.js App Router)
FRONTEND_PATH=`frontend/`
GENERATED_PATH=n/a
ORCHESTRATION=Docker Compose from repo root
OTHER_COMPONENTS=Docker Compose (`docker-compose.yml`); Railway staging (`railway/README.md`); Postgres via Compose/Railway
PLAN_DOC=docs/cursor-prompts/29-remaining-gaps-comprehensive.md
PROJECT_NAME=Pulse of Technology
README=README.md
REFERENCE_DOC=docs/operational-runbook.md
REPO_ROOT=`/` (monorepo root)
SCHEMA_PATH=`backend/models/` + `backend/alembic/versions/`
SERVICE_NETWORKING=Compose network; host ports Frontend `3100`, API `8100`, Postgres `5532`
SHARED_PATH=n/a (no shared package)
STATUS_DOC=README.md
TESTING_GUIDE_DOC=AGENTS.md (Testing section) and README.md
TEST_COMMAND_E2E=`npm run test:e2e` (frontend; full stack via Compose) or CI e2e job
TEST_COMMAND_PRIMARY=`docker compose exec -T backend bash -lc 'cd /app/backend && pytest -q'`
TEST_COMMAND_TYPECHECK=`docker compose exec -T backend bash -lc 'cd /app/backend && ruff check . && ruff format --check .'`; frontend `npm run lint`
TEST_COMMAND_UNIT=`docker compose exec -T frontend sh -lc 'npm run test'`
TEST_PATHS=`backend/tests/`, `frontend` Vitest under `frontend/src/**/*.test.ts`, Playwright `frontend/e2e/`
